ANALYTICS_PORT=8082
ANALYTICS_JWT_PUBLIC_KEY=<base64-encoded-32-byte-Ed25519-public-key>
LOG_LEVEL=info
LOG_FORMAT=json
ANALYTICS_KAFKA_BROKERS=localhost:9092
ANALYTICS_KAFKA_TOPIC=article-events
ANALYTICS_KAFKA_DLQ_TOPIC=article-events.dlq
ANALYTICS_KAFKA_CONSUMER_GROUP=analytics-events
ANALYTICS_KAFKA_BATCH_SIZE=500
ANALYTICS_KAFKA_FLUSH_INTERVAL=1s
ANALYTICS_RETRY_ATTEMPTS=3
ANALYTICS_RETRY_BACKOFF=100ms
ANALYTICS_COOKIE_SECURE=false
ANALYTICS_REDIS_ADDR=localhost:6379
ANALYTICS_CLICKHOUSE_ADDR=localhost:9000
ANALYTICS_CLICKHOUSE_DATABASE=default
ANALYTICS_CLICKHOUSE_USER=default
ANALYTICS_CLICKHOUSE_PASSWORD=
